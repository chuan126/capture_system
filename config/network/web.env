# Uvicorn监听RK3588所有网络接口，供同一局域网电脑访问。
UVICORN_HOST=0.0.0.0
UVICORN_PORT=8000

# CAPTURE_STATIC_DIR和CAPTURE_DATA_ROOT默认由启动脚本根据当前项目目录自动解析。
# 默认静态目录：<project_root>/frontend/out
# 默认运行目录：<project_root>/runtime
# 如现场确有独立数据盘需求，可取消下列注释并使用绝对路径覆盖。
# CAPTURE_STATIC_DIR=/mnt/data/capture_system/frontend/out
# CAPTURE_DATA_ROOT=/mnt/data/capture_runtime

# 两类正式 PDF 使用的中文宋体。字体文件不随项目分发，部署机必须单独安装。
CAPTURE_PDF_FONT_PATH=/usr/share/fonts/truetype/arphic-gbsn00lp/gbsn00lp.ttf

# 英文使用 Times New Roman。由于该字体有独立授权，仓库不分发字体文件；现场安装后
# 取消下一行注释并填写实际 TTF 路径。未配置时后端使用 PDF 标准 Times-Roman 兼容字体。
# CAPTURE_PDF_LATIN_FONT_PATH=/usr/share/fonts/truetype/msttcorefonts/Times_New_Roman.ttf

# 设备端只读扫描最大2 GiB的单任务数据库，向DeepSeek发送固定大小的证据审计包。
# 此值限制审计包本身，不限制measurements.db文件大小；20 MB是当前程序允许的上限。
CAPTURE_DEEPSEEK_MAX_PAYLOAD_BYTES=20000000

# 思考模式的内部推理与最终JSON共用此额度；最终JSON仍由Skill约束为最多250 tokens。
CAPTURE_DEEPSEEK_MAX_TOKENS=384000

# 高德地图Key与安全密钥由前端“地图设置”写入 runtime/settings/device_settings.json。
# 下列环境变量仅用于首次迁移或无配置文件时的兼容初始化，正常交付无需填写。
CAPTURE_AMAP_JS_KEY=
CAPTURE_AMAP_SECURITY_CODE=
