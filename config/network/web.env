# Uvicorn监听RK3588所有网络接口，供同一局域网电脑访问。
UVICORN_HOST=0.0.0.0
UVICORN_PORT=8000

# 前端构建脚本生成的静态文件绝对目录。
CAPTURE_STATIC_DIR=/home/cat/Project/capture_system/frontend/out

# 任务数据库和后续任务记录的设备端持久化根目录，必须位于项目源码目录之外。
CAPTURE_DATA_ROOT=/home/cat/.local/share/capture_system_all_features_test

# 正式 PDF 汇总使用的中文字体。字体文件不随项目分发，部署机必须单独安装。
CAPTURE_PDF_FONT_PATH=/usr/share/fonts/truetype/arphic-gbsn00lp/gbsn00lp.ttf
